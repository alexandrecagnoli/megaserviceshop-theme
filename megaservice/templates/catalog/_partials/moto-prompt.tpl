{* Bandeau discret d'invitation à choisir sa moto (PowerParts, aucun filtre actif).
   js-model-trigger ouvre la modale de sélection du header (cf. model-selector.js). *}
<div class="ms-moto-prompt">
  <div class="ms-moto-prompt__inner">
    <p class="ms-moto-prompt__text">{l s='Sélectionnez votre moto pour afficher uniquement les pièces compatibles.' d='Shop.Theme.Catalog'}</p>
    <button type="button" class="ms-moto-prompt__btn js-model-trigger">{l s='Choisir ma moto' d='Shop.Theme.Catalog'}</button>
  </div>
</div>
