# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Mac
.DS_Store

# IDE
.idea/
.vscode/

# Bundles
megaservice.zip

# Logs
*.log

# Presta cache (si tu ajoutes PrestaShop plus tard)
var/cache/
var/logs/

# Imports motos / microfiches : on ne versionne pas les gros CSV constructeur.
# Les samples (~30 lignes/marque) sont dans modules/megaservice_microfiches/samples/.
/data/imports/*.csv

# Dumps SQL (191 Mo) : jamais dans git.
/dumps/

# CSV constructeur deposes a la racine de data/ (la regle /data/imports/
# ci-dessus ne les couvrait pas).
/data/*.csv

# Docs volumineuses : archives fournisseur et leurs dossiers dezippes.
/docs/*.zip
/docs/ukooparts*/
/docs/ps_facetedsearch/

# Config locale Claude Code — sauf les skills, qui sont du travail d'equipe et
# doivent suivre le depot (sinon ils ne vivent que sur le poste qui les a crees).
# On exclut le CONTENU de .claude/, pas le dossier : git ne sait pas reinclure
# un fichier dont un dossier parent est exclu.
.claude/*
!.claude/skills/

# Sources constructeur brutes (3,8 Go : XML PIM, PHO, microfiches, exports).
/IMPORT_FILES/

# Visuels constructeur bruts deposes dans le theme (noms d'origine, avec espaces
# et references produit). Le theme ne consomme que les versions optimisees —
# cf. mosaic.tpl qui pointe img/mosaique/optimized/*.jpg. Ces sources ont ete
# commitees deux fois par megarde via un `git add` trop large : on les exclut.
megaservice/assets/img/*_MY*.jpg
megaservice/assets/img/mosaique/[0-9]*_*.jpg

# CSV de travail : liaisons produits, references manquantes, extraits de CSV
# constructeur. Ce sont des donnees generees par l'application d'export, pas du
# code — perimees au prochain export, et deja tracees ailleurs (le fichier
# importe vit sur la preprod, les sources constructeur dans data/imports/).
samples/*.csv
